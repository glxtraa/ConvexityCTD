{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/basket/:month", "destination": "/api/index?route=basket&month=:month" },
    { "source": "/api/market", "destination": "/api/index?route=market" },
    { "source": "/api/calculate", "destination": "/api/index?route=calculate" }
  ]
}
